# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=8384                         # Syncthing's web interface (GUI)
SYNC_PORT=22000                        # syncing with your devices, TCP and QUIC (UDP)
LAN_IP=192.168.1.20
TZ=Europe/London
APP_URL=http://192.168.1.20:8384
SSL_PROXY=0
HOST_UID=1027                          # the package's own user: Syncthing runs as it
HOST_GID=100
ST_IMAGE=syncthing/syncthing:2.1.6     # pinned; the Updates tab moves it to a newer release
ST_APIKEY=…                            # the package's key for Syncthing's REST API — root-only file
NET_MODE=host                          # host (the NAS's own network: local discovery works) | bridge
PRIVACY=anywhere                       # anywhere | local (no global discovery, relays or NAT traversal)
PLACE_1="/volume1/photos"              # synced shared folders, up to 8 places
PLACE_1_SRC="/volume1/photos"          # …mounted when the folder is there
PLACE_1_DST="/volume1/photos"
